# magi/gemini/.env.example
# ============================================================================
# Copy to magi/gemini/.env and edit. The deploy_gemini.sh installer sources
# this file when present and exports every variable into the harness install
# environment. Comments document each variable's effect.
# ============================================================================

# Target Gemini home directory. The installer copies the hook bridge into
# ${GEMINI_HOME}/enforcement/bin/ and the policy template into
# ${GEMINI_HOME}/policies/. Default: ${HOME}/.gemini
GEMINI_HOME=

# When 1 the hook bridge is installed under ${GEMINI_HOME}/enforcement/bin/.
# When 0 the deployer skips the hook copy. Default: 1
INSTALL_GEMINI_HOOKS=1

# When 1 LM Studio quality-review wiring is enabled in the policy template.
# Requires a reachable LM Studio endpoint. Default: 0
INSTALL_LM_STUDIO=0

# OpenAI-compatible LM Studio host. The doctor probe and runtime env both
# read this. Default: localhost
LM_STUDIO_HOST=localhost

# OpenAI-compatible LM Studio port. Default: 1234
LM_STUDIO_PORT=1234

# LM Studio model name used by the postPrompt review hook. Leave empty to
# let LM Studio's default model serve the request.
LM_STUDIO_MODEL=

# Token budget hint the hook reads from policies/enforcement.toml. Higher
# values increase review fidelity at latency cost. Default: 8192
GEMINI_TURN_CONTENT_LIMIT=8192
