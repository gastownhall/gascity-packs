# magi/openai/.env.example
# ============================================================================
# Copy to magi/openai/.env and edit. The deploy_openai.sh installer sources
# this file when present and exports every variable into the rendering
# pipeline. Comments document each variable's effect.
# ============================================================================

# Target directory the renderer writes config.toml + env.runtime into.
# Default: ${HOME}/.config/lm-studio-magi
OPENAI_TARGET_HOME=

# Host LM Studio binds to. Use localhost for single-user installations and
# 0.0.0.0 for LAN-multi-client (never expose the server publicly).
# Default: localhost
LM_STUDIO_HOST=localhost

# Port LM Studio binds to. LM Studio's own default is 1234.
# Default: 1234
LM_STUDIO_PORT=1234

# Default model id loaded at server start. Match a value returned by
# /v1/models. Empty = let LM Studio pick its UI default.
LM_STUDIO_MODEL=

# Default context window advertised by /v1/models. Must not exceed the
# loaded model's actual context window.
# Default: 8192
LM_STUDIO_CONTEXT=8192

# Comma-separated model ids LM Studio should warm-load at server start.
# Empty = no autoload.
LM_STUDIO_AUTOLOAD_MODELS=

# Optional API key passed to /v1/* endpoints. LM Studio ignores this by
# default but downstream tools (codex / claude analyzer) read it from
# env.runtime.
OPENAI_API_KEY=

# Override base URL. Defaults to http://${LM_STUDIO_HOST}:${LM_STUDIO_PORT}/v1
OPENAI_BASE_URL=
