        "LSP_USER": "__LSP_USER__",
        "LSP_PASS": "__LSP_PASS__"
      }
    },
    "tree-sitter": {
      "command": "uvx",
      "args": [
        "mcp-server-tree-sitter"
      ],
      "env": {}
    }
  }
}
