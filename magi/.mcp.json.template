    "remote-postgres": {
      "command": "bash",
      "args": [
        "-c",
        "exec sshpass -p \"${LSP_PASS}\" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \"${LSP_USER}@${LSP_IP}\" \"POSTGRES_CONNECTION_STRING=postgresql://${LSP_USER}:${LSP_PASS}@localhost:5432/claude_mcp __LSP_REMOTE_HOME__/.local/bin/mcp-postgres postgresql://${LSP_USER}:${LSP_PASS}@localhost:5432/claude_mcp\""
      ],
      "env": {
        "LSP_IP": "__LSP_IP__",
        "LSP_USER": "__LSP_USER__",
        "LSP_PASS": "__LSP_PASS__"
