{
  "mcpServers": {
    "guidelines-retriever": {
      "command": "node",
      "args": [
        "__CLAUDE_HOME__/mcp-servers/guidelines-retriever/index.js"
      ]
    },
    "project-memory": {
      "command": "node",
      "args": [
        "__CLAUDE_HOME__/mcp-servers/project-memory/index.js"
      ]
    },
    "system-info": {
      "command": "node",
      "args": [
        "__CLAUDE_HOME__/mcp-servers/system-info/index.js"
      ]
    },
    "remote-shell": {
      "command": "node",
      "args": [
        "__CLAUDE_HOME__/mcp-servers/remote-shell/index.js"
      ],
      "env": {
        "MCP_SSH_TIMEOUT": "30000"
      }
    },
    "filesystem-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "__USER_HOME__"
      ]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "everything-local": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-everything"
      ]
    },
    "remote-filesystem": {
      "command": "bash",
      "args": [
        "-c",
        "exec sshpass -p \"${LSP_PASS}\" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \"${LSP_USER}@${LSP_IP}\" \"__LSP_REMOTE_HOME__/.local/bin/mcp-filesystem __LSP_REMOTE_HOME__\""
      ],
      "env": {
        "LSP_IP": "__LSP_IP__",
        "LSP_USER": "__LSP_USER__",
        "LSP_PASS": "__LSP_PASS__"
      }
    },
    "remote-memory": {
      "command": "bash",
      "args": [
        "-c",
        "exec sshpass -p \"${LSP_PASS}\" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \"${LSP_USER}@${LSP_IP}\" \"__LSP_REMOTE_HOME__/.local/bin/mcp-memory\""
      ],
      "env": {
        "LSP_IP": "__LSP_IP__",
        "LSP_USER": "__LSP_USER__",
        "LSP_PASS": "__LSP_PASS__"
      }
    },
    "remote-fetch": {
