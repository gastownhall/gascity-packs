      ],
      "env": {
        "LSP_IP": "__LSP_IP__",
        "LSP_USER": "__LSP_USER__",
        "LSP_PASS": "__LSP_PASS__",
        "MY_GITEA_API_TOKEN": "__MY_GITEA_API_TOKEN__",
        "MY_GITEA_HOST": "__MY_GITEA_HOST__",
        "MY_GITEA_PORT": "__MY_GITEA_PORT__"
      }
    },
    "remote-context7": {
      "command": "bash",
