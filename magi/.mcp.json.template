    },
    "remote-puppeteer": {
      "command": "bash",
      "args": [
        "-c",
        "exec sshpass -p \"${LSP_PASS}\" ssh -o ConnectTimeout=10 -o StrictHostKeyChecking=no -o ServerAliveInterval=30 -o ServerAliveCountMax=120 \"${LSP_USER}@${LSP_IP}\" \"__LSP_REMOTE_HOME__/.local/bin/mcp-puppeteer\""
