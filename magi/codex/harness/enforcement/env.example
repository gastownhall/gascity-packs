# Codex enforcement runtime environment.
# Copy to ~/.codex/enforcement/env or let deploy_harness.sh create it.

CODEX_SKIP_QUALITY_CHECK=0
CODEX_MAX_QUALITY_ATTEMPTS=3
CODEX_TURN_CONTENT_LIMIT=70000

LM_STUDIO_HOST=localhost
LM_STUDIO_PORT=1234
LM_STUDIO_MODEL=nvidia/nemotron-3-super
LM_STUDIO_CONNECT_TIMEOUT=3
LM_STUDIO_MAX_TIME=75
