#!/usr/bin/env bash
# Phase 2 of the soak runbook (and a soak's scheduled switch at the end of
# its legacy half): drop session_reconciler so the controller boots v2 by default,
# restart the supervisor, and check what v2 adopted and restarted.
#
#   soak-phase2 hc-bringup v2-switch --drill   (phase 2: ends with an agent-kill drill)
#   soak-phase2 hc-soak soak-v2                (Soak 1's switch: no drill)
#   soak-phase2 hc-soak2 soak-v2               (Soak 2's, from its VM timer)
set -euo pipefail

CITY_NAME="${1:?usage: soak-phase2 <city> <phase> [--drill]}"
PHASE="${2:?usage: soak-phase2 <city> <phase> [--drill]}"
DRILL="${3:-}"
SOAK="$HOME/soak/bin/soak"
CITY="$HOME/cities/$CITY_NAME"
DATA="$HOME/soak-data/$CITY_NAME"
SETTLE_S="${SOAK_V2_SETTLE_S:-1800}"
CHECKS=(--check exec-runtime-identity --check ownerless-runtimes --check daemon-session-reconciler)

"$SOAK" guard
# The soak's switch runs from a VM timer (`soak schedule`): never on an aborted city.
if [ -e "$DATA/ABORTED" ]; then
  echo "soak-phase2: $CITY_NAME was aborted; no switch (see $DATA/ABORTED)" >&2
  exit 1
fi
# The check, load and probe timers run on the city ~/soak-data/current names
# and take their locks in its data directory: the switch's pause and locks
# below hold them off only when that city is this one. Its soak calls then
# stay on this city whatever current names later.
if ! [ "$HOME/soak-data/current" -ef "$DATA" ]; then
  echo "soak-phase2: ~/soak-data/current is not $DATA; no switch" >&2
  exit 1
fi
export SOAK_CITY="$CITY" SOAK_DATA="$DATA"
cd "$CITY"
"$SOAK" phase "$PHASE"
gc doctor "${CHECKS[@]}" --json > "$DATA/v2-before.json" || true
# A probe kill during the switch would read as a box v2 ended (V3). The
# probe timer, when it runs (the soak), pauses from before the first snapshot
# to after the second, and the switch holds probe.lock across both: every
# probe holds it from its flag check to its kill, so the switch first waits
# for a probe already running, and no probe kills in between.
# An abort can come while the switch runs; `soak check` holds check.lock for
# its whole run, the abort's included. The switch takes check.lock after
# probe.lock, looks for ABORTED again and holds the lock to the supervisor
# restart, so an abort either ends the switch before its config edit or waits
# for the restart. The timer resumes under check.lock and only while no
# ABORTED exists, so a resume never undoes an abort's stop. However the
# script ends, both locks are released (`flock -u`: a child left running
# keeps the descriptor, not the lock).
probe_paused=""
resume_probes() {
  flock -u 9 2>/dev/null || true
  exec 9>&-
  flock -u 8 2>/dev/null || true
  exec 8>&-
  if [ -n "$probe_paused" ]; then
    probe_paused=""
    exec 8>>"$DATA/check.lock"
    flock 8
    if [ -e "$DATA/ABORTED" ]; then
      echo "soak-phase2: $CITY_NAME was aborted; soak-probe.timer stays stopped (see $DATA/ABORTED)" >&2
    else
      systemctl --user start soak-probe.timer
    fi
    flock -u 8
    exec 8>&-
  fi
}
trap resume_probes EXIT
if systemctl --user is-active --quiet soak-probe.timer; then
  systemctl --user stop soak-probe.timer
  probe_paused=1
fi
exec 9>>"$DATA/probe.lock"
flock 9
exec 8>>"$DATA/check.lock"
flock 8
if [ -e "$DATA/ABORTED" ]; then
  echo "soak-phase2: $CITY_NAME was aborted; no switch (see $DATA/ABORTED)" >&2
  exit 1
fi
snap=$("$SOAK" snapshot)
"$SOAK" toml-del city.toml daemon session_reconciler
"$SOAK" note operator supervisor-restart "switch to the v2 reconciler"
systemctl --user restart gascity-supervisor.service
flock -u 8
exec 8>&-
sleep 90
# At soak log volume 500 lines cover well under 90 s; read far enough back to
# reach the restart.
if gc supervisor logs -n "${SOAK_V1_LOG_LINES:-50000}" | grep -F "city '$CITY_NAME': session reconciler: v2 (default: session_reconciler is unset)"; then
  echo "V1: the supervisor log names the v2 default"
else
  echo "V1: FAIL: no v2 default line for $CITY_NAME in the supervisor log" >&2
fi
gc doctor "${CHECKS[@]}" --json > "$DATA/v2-after.json" || true
"$SOAK" snapshot --compare "$snap" > "$DATA/v2-snapshot.json" || true
resume_probes
cat "$DATA/v2-snapshot.json"
echo "settling $SETTLE_S s"
sleep "$SETTLE_S"
# An abort since the restart ends the switch here: no drill on an aborted city.
if [ -e "$DATA/ABORTED" ]; then
  echo "soak-phase2: $CITY_NAME was aborted during the switch; no drill or report (see $DATA/ABORTED)" >&2
  exit 1
fi
if [ "$DRILL" = "--drill" ]; then
  "$SOAK" drill agent-kill
fi
"$SOAK" report --city "$CITY_NAME" --first-turns
