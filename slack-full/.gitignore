__pycache__/
*.pyc
.gc/

# Built adapter binary — produced by `go build` in adapter/ and read
# in place by the [[service]] proxy_process command.
adapter/gc-slack-adapter

# Built operator CLI binary — produced by `go build` in cli/ and exec'd
# by the commands/<cmd>.sh wrappers via $GC_PACK_DIR/cli/gc-slack-cli.
cli/gc-slack-cli

# Wrapper-script deployments rename the built binary to gc-slack-adapter.real
# (the checked-in path above becomes an env-loading wrapper). Ignore it too so
# pack-cache worktrees stay clean after local builds.
adapter/gc-slack-adapter.real
