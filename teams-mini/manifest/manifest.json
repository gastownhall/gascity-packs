{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.17/MicrosoftTeams.schema.json",
  "manifestVersion": "1.17",
  "version": "0.1.0",
  "id": "${TEAMS_APP_ID}",
  "packageName": "com.gascity.teamsmini",
  "developer": {
    "name": "Gas City",
    "websiteUrl": "https://github.com/gastownhall/gascity-packs",
    "privacyUrl": "https://github.com/gastownhall/gascity-packs/blob/main/teams-mini/README.md",
    "termsOfUseUrl": "https://github.com/gastownhall/gascity-packs/blob/main/LICENSE"
  },
  "name": {
    "short": "gc mayor",
    "full": "Gas City mayor (teams-mini)"
  },
  "description": {
    "short": "Talk to your Gas City mayor from Teams.",
    "full": "@-mention the bot in a channel, group chat, or personal chat and the message is bridged to your Gas City mayor session. Replies come back into the same conversation."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#2B2D42",
  "bots": [
    {
      "botId": "${TEAMS_APP_ID}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
