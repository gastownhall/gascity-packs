  "dependencies": {
    "@get-bb/plugin-sdk": "0.4.47",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "@types/react": "19.2.14"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
