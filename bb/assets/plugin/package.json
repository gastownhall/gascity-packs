{
  "name": "bb-plugin-gas-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.45.0 <0.46",
    "bbPluginSdk": ">=0.6.26 <0.7"
  },
  "bb": {
    "name": "Gas City",
    "description": "Configured Gas City agents, city and rig catalogs, and durable conversations on Gas City 1.5.",
    "branding": {
      "icon": "Building2"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js",
    "test": "node --test scripts/gc-contract.test.mjs && node test/run.mjs",
    "typecheck": "tsc --noEmit",
    "gc:generate": "node scripts/gc-contract.mjs generate",
    "gc:check": "node scripts/gc-contract.mjs check",
    "gc:check-live": "node scripts/gc-contract.mjs check-live"
  },
  "dependencies": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.23",
    "@hey-api/openapi-ts": "0.99.0",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/node": "22.19.7",
    "@types/react": "19.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "0.25.12",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "5.9.3",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
