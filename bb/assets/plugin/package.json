{
  "name": "bb-plugin-gas-city",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "bb": ">=0.42.1 <0.43",
    "bbPluginSdk": ">=0.4.47 <0.5"
  },
  "bb": {
