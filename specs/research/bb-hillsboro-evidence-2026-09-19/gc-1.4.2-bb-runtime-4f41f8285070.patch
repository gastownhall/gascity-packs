+func parseApprovalOptions(text string) []approvalOption {
+	var options []approvalOption
+	seen := make(map[string]bool)
+	selected, yes, no := 0, 0, 0
+	footer := false
+	for _, line := range strings.Split(text, "\n") {
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "" {
+			continue
+		}
+		if footer {
