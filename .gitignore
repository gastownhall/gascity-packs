
# Beads / Dolt files (added by gc bd init)
.dolt/
*.db
.beads-credential-key
.gc/

# Gas City
.beads/*
!.beads/config.yaml
!.beads/metadata.json

# gc bd export artifact auto-staged by pre-commit hook (export.git-add: true in
# /home/ds/gascity-packs/.beads/config.yaml). Keep it out of repo history —
# beads issues canonical store is the Dolt DB, not this file.
/issues.jsonl

# Python test/runtime artifacts
__pycache__/
*.py[cod]

# Disposable experimental cities may persist process environments. Keep local.
/specs/experiments/jev-evidence-routing/**/workspace/
/specs/experiments/jev-evidence-routing/**/pack-snapshot/

# Fixture source and proof are retained in suite/state JSON; nested Git stores stay local.
/specs/experiments/jev-evidence-routing/**/fixture/

# Full task transcripts are preserved locally; commit only their hashes and usage.
/specs/experiments/jev-evidence-routing/**/raw-transcripts/

# Expanded Jev benchmarks retain fixture contents in state/proof artifacts.
/specs/experiments/jev-expansion/**/fixture/

# All-enabled experiments retain fixtures/snapshots locally and publish audited records.
/specs/experiments/jev-all-enabled/**/fixture/
/specs/experiments/jev-all-enabled/**/pack-snapshot/
/specs/experiments/jev-all-enabled/**/raw-transcripts/

# Jev build A/B raw evidence stays on the host; only each experiment's
# write-up and report (the numbers) are tracked.
/specs/experiments/jev-overlay-ab/ab-00[2-9]*/*
!/specs/experiments/jev-overlay-ab/ab-00[2-9]*/README.md
!/specs/experiments/jev-overlay-ab/ab-00[2-9]*/report.md
!/specs/experiments/jev-overlay-ab/ab-00[2-9]*/report.json
/specs/experiments/jev-overlay-ab/smoke-001/
/specs/experiments/jev-overlay-ab/smoke-003/
